# ── 构建产物 ─────────────────────────────────────────────────────────────────
build/
build-*/
out/
.cache/

# ── 第三方依赖（由 scripts/fetch_deps.ps1 拉取，不入库）───────────────────────
external/

# ── 编辑器 ───────────────────────────────────────────────────────────────────
.vs/
.vscode/
.idea/
*.user
CMakeUserPresets.json

# ── Python（门禁脚本）────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/

# ── 编译产物 ─────────────────────────────────────────────────────────────────
*.obj
*.o
*.exe
*.dll
*.lib
*.pdb
*.ilk

# ── 测试与基准输出（不入库；黄金数据走专门目录）──────────────────────────────
Testing/
*.gcda
*.gcno

# ── 构建脚本的日志（scripts/build.ps1 产出）──────────────────────────────────
build*.configure.log
build*.build.log
build*.test.log
msvc_*.log
