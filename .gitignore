# ── 构建产物 ─────────────────────────────────────────────────────────────────
build/
build-*/
out/
.cache/

# ── 第三方依赖（由 scripts/fetch_deps.ps1 拉取，不入库）───────────────────────
external/

# ── 编辑器 ───────────────────────────────────────────────────────────────────
.vs/
.vscode/
.idea/
*.user
CMakeUserPresets.json

# ── Python（门禁脚本）────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/

# ── 编译产物 ─────────────────────────────────────────────────────────────────
*.obj
*.o
*.exe
*.dll
*.lib
*.pdb
*.ilk

# ── 测试与基准输出（不入库；黄金数据走专门目录）──────────────────────────────
Testing/
*.gcda
*.gcno

# ── 构建脚本的日志（scripts/build.ps1 产出）──────────────────────────────────
build*.configure.log
build*.build.log
build*.test.log
msvc_*.log
*-cfg.log
# 手工验证时用的日志：ms-msvc-*.log（一次性 MSVC 跑）、v-*.log（一次性验证跑）。
# 它们和 build*.log 是同类东西，只是名字不同；统一按"构建日志"忽略。
*-msvc-*.log
v-*.log

# ── 临时脚手架 ──────────────────────────────────────────────────────────────
# 门禁脚本的中间产物与调查用的一次性脚本。允许它们存在（开发时反复用到），
# 但不应进仓库：`tmp_*` 是刻意的命名约定，而不是"忘了删"。
tmp_*
plan.json

